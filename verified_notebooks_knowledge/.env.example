# ==============================================================================
# HALO RAG STUDIO — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and populate with your credentials. NEVER commit .env to git.
# ==============================================================================

# Model Provider Credentials
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
VLLM_API_KEY=your_vllm_api_key_here

# Local Model Endpoints
OLLAMA_BASE_URL=http://localhost:11434
LM_STUDIO_BASE_URL=http://localhost:1234/v1

# Cache & Storage
HALO_CACHE_DB=data/agent_reuse_cache.db
HALO_CONFIG_PATH=config/halo.yaml

# Logging & Telemetry
HALO_LOG_LEVEL=INFO
